# --- Database (docker-compose Postgres) ---
DATABASE_URL=postgresql+psycopg://questtour:questtour@localhost:5432/questtour
# password | azure_ad  (azure_ad = managed identity token as password, for App Service)
DATABASE_AUTH=password
# No-Docker fallback for a quick local smoke test:
# DATABASE_URL=sqlite:///./dev.db

HOST_ID=default
# Base URL printed in game links (Vite dev server proxies /api to :8000)
PUBLIC_BASE_URL=http://localhost:5173

# --- Blob storage ---
# azure (Azurite or Azure) | local (files under LOCAL_STORAGE_DIR)
STORAGE_BACKEND=azure
# Azurite's public, well-known development connection string:
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# Azure with managed identity instead of a connection string:
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
LOCAL_STORAGE_DIR=.storage
PHOTOS_CONTAINER=photos
IMAGES_CONTAINER=images

# Built SPA served by FastAPI (leave unset when using the Vite dev server)
# STATIC_DIR=../frontend/dist

# sync-config
CONFIG_DIR=config

# --- Admin auth / session ---
# dev (default) | entra (Microsoft Entra ID)
ADMIN_AUTH_PROVIDER=dev
# Must be at least 32 bytes in production.
ADMIN_SESSION_SECRET=dev-secret-do-not-use-in-production-with-claude-code
ADMIN_SESSION_MAX_AGE_MINUTES=720
# Set to true in production to require HTTPS for the admin session cookie.
ADMIN_SESSION_SECURE=false

# Entra settings (required when ADMIN_AUTH_PROVIDER=entra)
# ADMIN_ENTRA_TENANT_ID=
# ADMIN_ENTRA_CLIENT_ID=
# ADMIN_ENTRA_CLIENT_SECRET=
# ADMIN_ENTRA_REDIRECT_URI=http://localhost:8000/api/admin/auth/callback
# ADMIN_ENTRA_GROUP_OBJECT_ID=

# Comma-separated list of admin emails for dev provider.
ADMIN_DEV_EMAILS=

# Prod only (set by Terraform as App Service settings): NOLOGIN role that owns the tables.
# Migrations SET ROLE to it so the app identity and the admin (sync-config) can both use them.
# DATABASE_OWNER_ROLE=questtour_owner
